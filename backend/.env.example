# ── Application ──────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development
APP_VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# Relative to backend/ directory. SQLite file is auto-created on first run.
DATABASE_URL=sqlite:///./database.db

# ── Storage ───────────────────────────────────────────────────────────────────
# Absolute path or relative to backend/. Sub-dirs uploads/, exports/, temp/
# are created automatically on startup.
STORAGE_DIR=./storage

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# ── Whisper (Faster-Whisper) ──────────────────────────────────────────────────
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=2048
